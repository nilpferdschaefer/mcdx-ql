<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.nilpferdschaefer</groupId>
  <artifactId>mcdx-ql</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>
  <name>mcdx-ql</name>
  <description>Java bindings for mcdx_ql (indicator grammar → SQL)</description>
  <url>https://github.com/nilpferdschaefer/mcdx-ql</url>

  <scm>
    <url>https://github.com/nilpferdschaefer/mcdx-ql</url>
    <connection>scm:git:https://github.com/nilpferdschaefer/mcdx-ql.git</connection>
    <developerConnection>scm:git:https://github.com/nilpferdschaefer/mcdx-ql.git</developerConnection>
  </scm>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>
    <!-- Overridden in CI: https://maven.pkg.github.com/OWNER/REPO -->
    <github.maven.repo>https://maven.pkg.github.com/nilpferdschaefer/mcdx-ql</github.maven.repo>
  </properties>

  <distributionManagement>
    <repository>
      <id>github</id>
      <name>GitHub Packages</name>
      <url>${github.maven.repo}</url>
    </repository>
    <snapshotRepository>
      <id>github</id>
      <name>GitHub Packages Snapshots</name>
      <url>${github.maven.repo}</url>
    </snapshotRepository>
  </distributionManagement>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <archive>
            <manifestEntries>
              <Automatic-Module-Name>com.nilpferdschaefer.mcdxql</Automatic-Module-Name>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.11.2</version>
        <configuration>
          <source>${maven.compiler.release}</source>
          <encoding>UTF-8</encoding>
          <doclint>all,-missing</doclint>
          <quiet>true</quiet>
          <show>protected</show>
          <windowtitle>mcdx-ql ${project.version} API</windowtitle>
          <doctitle>mcdx-ql ${project.version}</doctitle>
        </configuration>
        <executions>
          <execution>
            <id>attach-javadocs</id>
            <goals>
              <goal>jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
